{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "onestorage-apps",
  "main": "src/apps-gateway.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "worker_loaders": [
    {
      "binding": "LOADER"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "onestorage",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "OBJECTS",
      "bucket_name": "onestorage-objects"
    }
  ],
  "workers_dev": true,
  "observability": {
    "enabled": true
  }
}
