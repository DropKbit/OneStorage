{
  "name": "onestorage",
  "version": "0.16.0",
  "private": true,
  "description": "Git hosting implemented in JavaScript on Cloudflare Workers, R2 and Durable Objects",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:worker": "wrangler dev --config wrangler.local.jsonc",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "node scripts/e2e.mjs",
    "check": "npm run typecheck && npm test",
    "build": "wrangler deploy --dry-run --outdir dist --config wrangler.local.jsonc",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 migrations apply DB --local --config wrangler.local.jsonc",
    "db:remote": "wrangler d1 migrations apply DB --remote",
    "build:production": "wrangler deploy --dry-run --outdir dist/production",
    "format": "prettier --write src sdk public scripts tests docs *.md *.json *.jsonc .github",
    "source": "node scripts/source.mjs",
    "predeploy": "npm run source",
    "prebuild": "npm run source",
    "prebuild:production": "npm run source",
    "test:features": "node scripts/e2e-features.mjs",
    "test:git-features": "node scripts/e2e-git-features.mjs",
    "test:sync": "node scripts/e2e-sync.mjs",
    "test:sdks": "node scripts/e2e-sdks.mjs",
    "test:parity": "node scripts/parity.mjs",
    "test:platform": "node scripts/e2e-platform.mjs",
    "runner": "node scripts/runner.mjs",
    "test:collaboration": "node scripts/e2e-collaboration.mjs",
    "deploy:apps": "wrangler deploy --config wrangler.apps.jsonc",
    "test:account": "node scripts/e2e-account.mjs",
    "test:reviews": "node scripts/e2e-fork-reviews.mjs",
    "test:codeowners": "node scripts/e2e-codeowners.mjs",
    "test:issues": "node scripts/e2e-issues.mjs",
    "test:archive": "node scripts/e2e-archive.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "test:transfer": "node scripts/e2e-transfer.mjs",
    "test:scale": "node scripts/e2e-scale.mjs",
    "test:ui": "node scripts/e2e-ui.mjs",
    "test:review-ui": "node scripts/e2e-review-ui.mjs",
    "test:workflows": "node scripts/e2e-workflows.mjs",
    "test:workflow-ui": "node scripts/e2e-workflow-ui.mjs",
    "test:workflow-git": "node scripts/e2e-workflow-git.mjs",
    "test:git-reliability": "node scripts/e2e-git-reliability.mjs",
    "test:receive-scale": "ONESTORAGE_SINGLE_IMPORT=1 node scripts/e2e-scale.mjs"
  },
  "dependencies": {
    "diff": "9.0.0",
    "highlight.js": "^11.12.0",
    "hono": "^4.13.7",
    "jose": "^6.2.12",
    "markdown-it": "^15.0.1",
    "node-diff3": "3.2.1",
    "openpgp": "6.3.1",
    "pako": "2.2.0",
    "qrcode-generator": "^2.0.4",
    "re2js": "2.8.6",
    "tar": "^7.5.22",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260907.1",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.5.0",
    "@types/pako": "^2.0.4",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "wrangler": "^4.129.1"
  }
}
