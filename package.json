{
  "name": "onestorage",
  "version": "0.39.0",
  "private": true,
  "description": "Git hosting implemented in JavaScript on Cloudflare Workers, R2 and Durable Objects",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:worker": "wrangler dev --config wrangler.local.jsonc",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts tests/*.test.mjs",
    "test:e2e": "node scripts/e2e.mjs",
    "check": "npm run typecheck && npm test",
    "build": "node scripts/source.mjs",
    "deploy": "node scripts/deploy-template.mjs",
    "db:local": "wrangler d1 migrations apply DB --local --config wrangler.local.jsonc",
    "db:remote": "wrangler d1 migrations apply DB --remote",
    "build:production": "wrangler deploy --dry-run --outdir dist/production",
    "format": "prettier --write src sdk public scripts tests docs *.md *.json *.jsonc .github",
    "source": "node scripts/source.mjs",
    "prebuild:production": "npm run source",
    "test:features": "node scripts/e2e-features.mjs",
    "test:git-features": "node scripts/e2e-git-features.mjs",
    "test:sync": "node scripts/e2e-sync.mjs",
    "test:sdks": "node scripts/e2e-sdks.mjs",
    "test:parity": "node scripts/parity.mjs",
    "test:platform": "node scripts/e2e-platform.mjs",
    "runner": "node scripts/runner.mjs",
    "test:collaboration": "node scripts/e2e-collaboration.mjs",
    "deploy:apps": "wrangler deploy --config wrangler.apps.jsonc",
    "test:account": "node scripts/e2e-account.mjs",
    "test:reviews": "node scripts/e2e-fork-reviews.mjs",
    "test:codeowners": "node scripts/e2e-codeowners.mjs",
    "test:issues": "node scripts/e2e-issues.mjs",
    "test:archive": "node scripts/e2e-archive.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "test:transfer": "node scripts/e2e-transfer.mjs",
    "test:scale": "node scripts/e2e-scale.mjs",
    "test:ui": "node scripts/e2e-ui.mjs",
    "test:review-ui": "node scripts/e2e-review-ui.mjs",
    "test:workflows": "node scripts/e2e-workflows.mjs",
    "test:workflow-ui": "node scripts/e2e-workflow-ui.mjs",
    "test:workflow-git": "node scripts/e2e-workflow-git.mjs",
    "test:git-reliability": "node scripts/e2e-git-reliability.mjs",
    "test:receive-scale": "ONESTORAGE_SINGLE_IMPORT=1 node scripts/e2e-scale.mjs",
    "test:pack-cache": "ONESTORAGE_PACK_CACHE=1 node scripts/e2e-scale.mjs",
    "test:read-concurrency": "ONESTORAGE_READ_CONCURRENCY=1 node scripts/e2e-scale.mjs",
    "test:schedules": "node scripts/e2e-schedules.mjs",
    "test:schedule-ui": "node scripts/e2e-schedule-ui.mjs",
    "test:variables": "node scripts/e2e-variables.mjs",
    "test:variable-ui": "node scripts/e2e-variable-ui.mjs",
    "test:caches": "node scripts/e2e-caches.mjs",
    "test:cache-ui": "node scripts/e2e-cache-ui.mjs",
    "dev:build": "wrangler dev --config wrangler.build.jsonc --persist-to .wrangler/compiler",
    "deploy:build": "wrangler deploy --config wrangler.build.jsonc",
    "test:builds": "node scripts/e2e-builds.mjs",
    "build:compiler": "wrangler deploy --dry-run --config wrangler.build.jsonc --outdir dist/compiler",
    "test:oidc": "node scripts/e2e-oidc.mjs",
    "test:workspace-variables": "ONESTORAGE_WORKSPACE_VARIABLES=1 node scripts/e2e-variables.mjs",
    "test:workspace-variable-ui": "ONESTORAGE_WORKSPACE_VARIABLES=1 node scripts/e2e-variable-ui.mjs",
    "test:packages": "node scripts/e2e-packages.mjs",
    "test:deploy-tokens": "node scripts/e2e-deploy-tokens.mjs",
    "test:private-builds": "node scripts/e2e-private-builds.mjs",
    "test:search": "node scripts/e2e-search.mjs",
    "test:git-receipts": "node scripts/e2e-git-receipts.mjs",
    "test:password-recovery": "node scripts/e2e-password-recovery.mjs",
    "test:merge-queue": "node scripts/e2e-merge-queue.mjs",
    "test:code-index": "node scripts/e2e-code-index.mjs",
    "test:oauth": "node scripts/e2e-oauth.mjs",
    "test:code-content": "ONESTORAGE_SHARED_CODE=1 node scripts/e2e-code-index.mjs",
    "test:npm-cache": "ONESTORAGE_NPM_CACHE=1 node scripts/e2e-builds.mjs",
    "test:tsconfig": "ONESTORAGE_TSCONFIG=1 node scripts/e2e-builds.mjs",
    "test:notebook": "node scripts/e2e-notebook.mjs",
    "test:i18n": "node scripts/e2e-i18n.mjs",
    "docs": "node scripts/docs.mjs",
    "test:browse-cache": "node scripts/e2e-browse-cache.mjs"
  },
  "dependencies": {
    "cron-parser": "5.10.0",
    "diff": "9.0.0",
    "dompurify": "3.4.15",
    "esbuild-wasm": "0.28.2",
    "highlight.js": "^11.12.0",
    "hono": "^4.13.7",
    "jose": "^6.2.12",
    "jsonc-parser": "3.3.1",
    "markdown-it": "^15.0.1",
    "node-diff3": "3.2.1",
    "openpgp": "6.3.1",
    "pako": "2.2.0",
    "qrcode-generator": "^2.0.4",
    "re2js": "2.8.6",
    "resolve.exports": "2.0.3",
    "semver": "7.8.5",
    "tar": "^7.5.22",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260907.1",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.5.0",
    "@types/pako": "^2.0.4",
    "@types/semver": "7.8.0",
    "acorn": "8.18.0",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "wrangler": "^4.129.1"
  },
  "cloudflare": {
    "bindings": {
      "BOOTSTRAP_SECRET": {
        "description": "首次创建管理员的初始化密钥。请使用 openssl rand -hex 32 生成并保存，不使用本地开发值。"
      },
      "CREDENTIAL_ENCRYPTION_KEY": {
        "description": "凭据加密密钥。请使用 openssl rand -base64 32 生成（32 随机字节），升级时必须保留。"
      },
      "NPM_CACHE": {
        "description": "独立的公共 npm 下载缓存 R2 桶；不能与 Git 对象桶共用。"
      }
    }
  }
}
