{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "onestorage-local",
  "main": "src/local.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  "vars": {
    "APP_ORIGIN": "http://localhost:8787",
    "BOOTSTRAP_SECRET": "local-development-only-change-me",
    "WEBHOOK_ALLOWED_HOSTS": "",
    "CREDENTIAL_ENCRYPTION_KEY": "bG9jYWwtdGVzdC1vbmx5LW5ldmVyLXVzZS1pbi1wcm8=",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "onestorage-local",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "OBJECTS",
      "bucket_name": "onestorage-local",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "REPOSITORIES",
        "class_name": "Repository",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Repository"],
    },
  ],
  "dev": {
    "port": 8787,
    "ip": "127.0.0.1",
  },
  "queues": {
    "producers": [
      {
        "binding": "EVENTS",
        "queue": "onestorage-local-events",
      },
    ],
    "consumers": [
      {
        "queue": "onestorage-local-events",
        "max_batch_size": 5,
        "max_batch_timeout": 1,
        "max_retries": 5,
      },
    ],
  },
  "triggers": {
    "crons": ["*/5 * * * *"],
  },
}
