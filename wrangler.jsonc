{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "onestorage",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "limits": {
    "subrequests": 250000,
  },
  "services": [
    {
      "binding": "BUILDER",
      "service": "onestorage-build",
    },
  ],
  "worker_loaders": [
    {
      "binding": "LOADER",
    },
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "onestorage",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "OBJECTS",
      "bucket_name": "onestorage-objects",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "REPOSITORIES",
        "class_name": "Repository",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Repository"],
    },
  ],
  "observability": {
    "enabled": true,
  },
  "queues": {
    "producers": [
      {
        "binding": "EVENTS",
        "queue": "onestorage-events",
      },
    ],
    "consumers": [
      {
        "queue": "onestorage-events",
        "max_batch_size": 5,
        "max_batch_timeout": 1,
        "max_retries": 5,
      },
    ],
  },
  "triggers": {
    "crons": ["*/5 * * * *"],
  },
  "workers_dev": true,
}
