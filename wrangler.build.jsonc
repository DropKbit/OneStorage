{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "onestorage-build",
  "main": "src/build-worker.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "preview_urls": false,
  "limits": { "cpu_ms": 60000 },
  "rules": [
    { "type": "CompiledWasm", "globs": ["**/*.wasm"], "fallthrough": true },
  ],
  "dev": { "port": 8788, "ip": "127.0.0.1" },
}
