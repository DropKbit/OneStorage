      "source": [
        "# OneStorage Notebook 示例\n",
        "直接在 Git 仓库中浏览已有的笔记本输出。预览不会执行代码。\n\n",
        "下面的示例展示 Python 高亮、文本、静态表格与 PNG 图表。"
      ]
    },
    {
      "cell_type": "code",
      "id": "result",
      "metadata": {},
      "source": [
        "values = [15, 30, 45, 60, 75, 90]\n",
        "print(f\"样本数: {len(values)}，总和: {sum(values)}\")"
      ],
      "execution_count": 1,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "样本数: 6，总和: 315\n"
          ]
        },
        {
          "output_type": "display_data",
          "metadata": {},
          "data": {
            "text/html": [
              "<table><thead><tr><th>指标</th><th>数值</th></tr></thead><tbody><tr><td>样本数</td><td>6</td></tr><tr><td>总和</td><td>315</td></tr></tbody></table>"
            ],
            "text/plain": [
              "样本数: 6; 总和: 315"
            ]
          }
        },
        {
          "output_type": "display_data",
          "metadata": {},
